{
    "name": "prsv/blogy",
    "description": "Simple blog application built with pure PHP, MySQL, and Smarty.",
    "type": "project",
    "require": {
        "php": "^8.1",
        "smarty/smarty": "^5.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
