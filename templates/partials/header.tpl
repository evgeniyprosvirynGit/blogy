<header class="border-b border-slate-900/10 bg-slate-900">
    <div class="mx-auto flex max-w-6xl items-center px-4 py-3 sm:px-6">
        <a
            href="/"
            class="inline-flex items-center gap-3 rounded-full transition hover:opacity-85 focus:outline-none focus:ring-2 focus:ring-amber-500/70 focus:ring-offset-2 focus:ring-offset-slate-900"
            aria-label="{$app.name} home"
        >
            <img
                src="/images/icons/blog-writing-svgrepo-com.svg"
                alt="{$app.name} logo"
                class="h-9 w-9 shrink-0 sm:h-10 sm:w-10"
            >
            <span class="text-sm font-semibold uppercase tracking-[0.28em] text-stone-50 sm:text-base">
                {$app.name}
            </span>
        </a>
    </div>
</header>
