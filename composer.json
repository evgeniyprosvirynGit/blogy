{
    "name": "prsv/blogy",
    "description": "Simple blog application built with pure PHP, MySQL, and Smarty.",
    "type": "project",
    "require": {
        "php": "^8.1",
        "illuminate/database": "^13.21",
        "smarty/smarty": "^5.5",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "migrate": "vendor/bin/phinx migrate -c phinx.php",
        "seed": "vendor/bin/phinx seed:run -c phinx.php",
        "test": "vendor/bin/pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "laravel/pint": "^1.29",
        "pestphp/pest": "^4",
        "robmorgan/phinx": "^0.16.12"
    }
}
